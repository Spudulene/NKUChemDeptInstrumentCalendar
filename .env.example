# Copy to .env and fill in. Nothing here is secret in local development.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local: these defaults match the Postgres in compose.yaml — `npm run db:up`.
# No pooler in front of it, so both URLs are the same value.
#
# Avoid `npx prisma dev` here: it re-rolls an ephemeral port on every restart,
# silently invalidating whatever is written below.
#
# Neon: DATABASE_URL is the POOLED host (contains "-pooler"), DIRECT_URL is the
# unpooled one. The app uses the pooler because serverless functions open far more
# connections than Postgres tolerates; migrations use the direct URL because
# PgBouncer in transaction mode cannot run DDL reliably.
DATABASE_URL="postgres://instrument:local-dev-only@localhost:5433/instrument_calendar"
DIRECT_URL="postgres://instrument:local-dev-only@localhost:5433/instrument_calendar"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
CAMPUS_TIMEZONE="America/New_York"

# Signs session cookies. Required in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Promoted to ADMIN by the seed and by dev login. Comma-separated.
ADMIN_EMAILS="krussellc2@gmail.com"

# Password-less login at /dev-login. Forced off in production regardless.
ENABLE_DEV_LOGIN="true"

# ---------------------------------------------------------------------------
# Entra SSO — leave blank until the app registration exists
# ---------------------------------------------------------------------------
# ENTRA_TENANT_ID is the tenant lock: sign-ins whose `tid` claim differs are
# rejected. Without it, any Microsoft account anywhere could sign in.
# This file is COMMITTED. Never put real values here — they belong in .env.
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Email — optional; unset just logs what would have been sent
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
MAIL_FROM="Instrument Calendar <onboarding@resend.dev>"

# Connections per app instance. Leave unset for the default of 5. Set to 1 if you
# are developing against the `npx prisma dev` proxy, which serialises connections.
# DATABASE_POOL_MAX="5"
